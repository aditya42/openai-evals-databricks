# Set values in your shell or GitHub Actions repository secrets; never commit keys.
# Files named .env are not loaded automatically by this runner.
OPENAI_API_KEY=
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# Use either a PAT or OAuth M2M service principal credentials.
DATABRICKS_TOKEN=
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=default
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_NAME=/Shared/openai-llm-evals
DATABRICKS_DASHBOARD_PARENT=/Shared
# Optional existing dashboard ID; otherwise the dashboard is found by name and folder.
# DATABRICKS_DASHBOARD_ID=
